# ==============================================================
# Avrora Dazzle Frontend - Environment Variables
# Copy this file to .env and fill in your production values
# ==============================================================

# Port for the Next.js server
PORT=3001

# Backend API Base URL
# Example: https://api.yourdomain.com/api
NEXT_PUBLIC_API_BASE_URL=

# PayHere Payment Gateway
# Set to 'false' for production, 'true' for sandbox/testing
NEXT_PUBLIC_PAYHERE_SANDBOX=false

# PayHere Notify URL - must be publicly accessible in production
# Example: https://api.yourdomain.com/api/payment/payhere-notify
NEXT_PUBLIC_PAYHERE_NOTIFY_URL=
