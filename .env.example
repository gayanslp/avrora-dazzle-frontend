# Next.js Port Configuration
PORT=3001

# Backend API Endpoint for Axios Instance
# Change this to your production API URL when deploying
NEXT_PUBLIC_API_BASE_URL=https://api.avroradazzle.com/api
# PayHere Payment Gateway Configuration
# Set to 'true' ONLY for testing/sandbox mode. In production, set to 'false' or remove this line.
NEXT_PUBLIC_PAYHERE_SANDBOX=true

# PayHere Notify URL — your production backend endpoint that PayHere calls to confirm payments
# MUST be a publicly accessible URL (not localhost) in production
NEXT_PUBLIC_PAYHERE_NOTIFY_URL=https://api.avroradazzle.com/api/payment/payhere-notify
